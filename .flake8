[flake8]
# Maximum line length
max-line-length = 127

# Maximum complexity
max-complexity = 10

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .coverage,
    htmlcov,
    data,
    alembic

# Ignore specific errors
ignore = E203,E501,W503,W504,F401

# Select specific checks
select = E,W,F,C

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F401,F811

# Show source code for errors
show-source = True

# Show error statistics
statistics = True

# Count errors
count = True
