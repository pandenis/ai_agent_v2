# AI Agent v2 - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# ========================================
# 🔑 API Keys and Credentials
# ========================================

# Groq API Key (get from https://console.groq.com/)
# IMPORTANT: Rotate your key if the old one was exposed!
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (optional, if using OpenAI models)
# OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# 🤖 Model Configuration
# ========================================

# DeepSeek Model Path (llama.cpp binary location)
DEEPSEEK_MODEL_PATH=/path/to/llama_cpp/build/bin/llama-cli
DEEPSEEK_MODEL_FILE=/path/to/deepseek-coder-6.7b-instruct.Q4_K_M.gguf

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_MISTRAL=mistral:7b-instruct
OLLAMA_MODEL_LLAMA3=llama3:8b
OLLAMA_MODEL_MEDICAL=medllama2

# ========================================
# 🔒 Security Settings
# ========================================

# Secret key for session management (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_use_openssl_rand

# Max input length (characters)
MAX_PROMPT_LENGTH=4000

# Max file upload size (bytes) - default 10MB
MAX_FILE_SIZE=10485760

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.txt,.pdf,.docx,.csv

# ========================================
# 💾 Database Configuration
# ========================================

# SQLite database path
DATABASE_URL=sqlite:///./data/agent.db

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma

# ========================================
# 📝 Logging Configuration
# ========================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/app.log

# Security log file
SECURITY_LOG_FILE=./logs/security.log

# ========================================
# 🌐 Server Configuration
# ========================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Gradio UI
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# Enable CORS (for development only!)
ENABLE_CORS=false

# ========================================
# 🎯 Feature Flags
# ========================================

# Enable web search
ENABLE_WEB_SEARCH=true

# Enable document search
ENABLE_DOCUMENT_SEARCH=true

# Enable journal
ENABLE_JOURNAL=true

# Enable memory system
ENABLE_MEMORY=true

# ========================================
# 📊 Performance Settings
# ========================================

# Number of search results
DEFAULT_SEARCH_RESULTS=3

# Context window size (tokens)
CONTEXT_WINDOW_SIZE=4096

# Temperature for model responses
DEFAULT_TEMPERATURE=0.7

# ========================================
# 🔧 Development Settings
# ========================================

# Environment mode (development, production)
ENVIRONMENT=development

# Enable debug mode
DEBUG=false

# Enable hot reload (development only)
RELOAD=true